# Verse 羁绊书境 v4.3 运行配置模板（复制为 .env 并填写真实值）
PORT=3000
JWT_SECRET=请更换为一段随机长字符串
# 数据库（MySQL，必填）
DB_URL=jdbc:mysql://localhost:3306/verse_v4?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
# TTS（火山引擎）：不填则念书返回 503 降级文案
TTS_API_KEY=
TTS_RESOURCE_ID=
# 生图（火山方舟 ARK）：不填则绘书封/插图返回 503 降级文案
ARK_API_KEY=
# 聊天大模型：不填则聊天功能不可用
LLM_API_KEY=
